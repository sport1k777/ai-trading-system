BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_NOTIFY_MIN_CONFIDENCE=70
SIGNAL_SERVICE_SCAN_INTERVAL_SECONDS=60
SIGNAL_SERVICE_SENT_STORE_PATH=.cache/telegram_sent_signals.json
SIGNAL_SERVICE_ERROR_BACKOFF_SECONDS=10
SIGNAL_SERVICE_RECONNECT_AFTER_ERRORS=3
# Signal validation (pre-Telegram)
VALIDATION_MIN_RISK_PCT=0.3
VALIDATION_MAX_RISK_PCT=3.0
VALIDATION_ENTRY_MAX_DISTANCE_PCT=1.0
TP_MIN_RR_TP1=1.5
TP_MIN_RR_TP2=2.5
TP_MIN_RR_TP3=3.5
MIN_STOP_ATR_MULT=0.25
FAST_SCAN_ENABLED=true
FAST_SCAN_CANDIDATE_COUNT=25
FAST_SCAN_MIN_UNIVERSE=30
VALIDATION_RR_TOLERANCE_PCT=0.05
VALIDATION_PRICE_DRIFT_MAX_PCT=0.25
SIGNAL_DUPLICATE_WINDOW_MINUTES=30
# Expanded scanner (Bybit linear USDT perps)
SCANNER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
SCANNER_SYMBOL_TARGET=150
SCANNER_MIN_TURNOVER_24H=500000
SCANNER_MAX_SPREAD_PCT=0.5
SCANNER_MAX_WORKERS=0
SCANNER_UNIVERSE_CACHE_SECONDS=3600
SCANNER_CPU_LIMIT_PCT=80
SCANNER_RAM_LIMIT_MB=2048
TESTNET=true
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=15
DEFAULT_CANDLE_LIMIT=250
# Strategy tuning
MIN_ADX=24
MIN_CONFLUENCE=5
STOP_ATR_MULT=1.0
TP_R_MULT=2.0
MIN_BARS_BETWEEN_TRADES=5
# Signal Engine PRO
PRO_MIN_CONDITIONS=5
PRO_MIN_CONFIDENCE=65
PRO_MIN_DIRECTION_GAP=10
# Engine version: v1 (checklist PRO) or v2 (sequential SMC)
