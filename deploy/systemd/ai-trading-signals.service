[Unit]
Description=AI Trading Telegram Signal Service
Documentation=file:///opt/ai-trading-system/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ai-trading-system
Environment=PYTHONPATH=/opt/ai-trading-system
EnvironmentFile=-/opt/ai-trading-system/.env
ExecStart=/opt/ai-trading-system/scripts/run_signal_service_prod.sh
Restart=always
RestartSec=15
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-trading-signals

[Install]
WantedBy=multi-user.target
