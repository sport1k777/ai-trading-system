# VPS Git deployment configuration (optional).
# Copy to the server and source before running deploy scripts:
#   cp deploy.env /etc/ai-trading/deploy.env
#   set -a && source /etc/ai-trading/deploy.env && set +a
#   bash /opt/ai-trading-system/scripts/deploy/update.sh

# Git remote and branch
GIT_REPO=https://github.com/sport1k777/ai-trading-system.git
GIT_BRANCH=cursor/ai-signal-engine-production

# Paths
DEPLOY_ROOT=/opt/ai-trading-system
BACKUP_ROOT=/opt/ai-trading-system-backups
VENV_DIR=/opt/ai-trading-system/venv
ENV_FILE=/opt/ai-trading-system/.env

# systemd
SERVICE_NAME=ai-trading-signals

# Set to 1 to overwrite an existing systemd unit from the repo template
# FORCE_SYSTEMD=0
